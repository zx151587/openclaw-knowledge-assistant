# 新增 ChromaDB 服务地址配置
CHROMA_HOST=localhost
CHROMA_PORT=8000


# ChromaDB 持久化路径（Windows 路径用正斜杠或双反斜杠）
CHROMA_PATH=../data/chroma
# 集合名称
COLLECTION_NAME=personal_knowledge
# 嵌入模型（中文场景首选）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 服务端口
SERVER_PORT=3000

# Hugging Face 国内镜像站，解决模型下载超时
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录，放在项目内，不占用C盘，团队路径统一
HF_HOME=./hf_cache